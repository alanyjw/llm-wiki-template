**/.DS_Store

# Asset binaries (images, PDFs) aren't tracked, but keep the folder itself
# so Obsidian always has an attachment target on a fresh clone / zip download.
assets/*
!assets/.gitkeep
node_modules/**

# qmd project-local search index — per-machine (sqlite + absolute paths in
# .qmd/index.yml). Regenerated by ./setup.sh; never shared.
.qmd/

# Obsidian UI state — churns every session, not meaningful to track
.obsidian/workspace.json
.obsidian/graph.json

# Claude Code local-only config — per-machine permission allowlist, not shared
.claude/settings.local.json

# Scheduled-task lock — per-machine runtime artefact, not shared
.claude/scheduled_tasks.lock

# Python bytecode cache from .claude/scripts/ — regenerated, not shared
**/__pycache__/

# Git worktrees — isolated per-task workspaces, never tracked
.claude/worktrees/
